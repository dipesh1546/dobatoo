# ========================================================
# DOBATO Backend - Environment Variables Template
# Copy this file to .env and provide real credentials
# ========================================================

# Application Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://dobato.app
CORS_ORIGINS=https://dobato.app,https://www.dobato.app

# Database Configuration (MongoDB Atlas Connection URI)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dobato_db?retryWrites=true&w=majority&appName=Cluster0

# Security & Authentication (Generate random 64-character secret)
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_at_least_32_chars

# Initial Super Admin Credentials (used during seed)
SUPERADMIN_EMAIL=superadmin@dobato.app
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!

# Transactional Email Configuration (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_FROM=no-reply@dobato.app
SMTP_FROM_NAME="DOBATO Event Team"

# API Documentation (Set to 'false' in high-security production environments)
ENABLE_SWAGGER=true
