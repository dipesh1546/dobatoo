# DOBATO Frontend Environment Variables Template
# Copy to .env or .env.development

# Public Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public Website URL
VITE_PUBLIC_WEB_URL=https://dobato.app

# Cloudinary Configuration (Optional for direct client-side photo upload)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Analytics & Monitoring Configuration (Optional)
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=
